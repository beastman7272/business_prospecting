# Copy to .env and fill in real values. Do NOT commit the real .env.

# Google Places API (Stage 1 discovery)
GOOGLE_PLACES_API_KEY=

# OpenAI API (Enrich, contact discovery, dossiers)
OPENAI_API_KEY=

# Optional model overrides (defaults shown)
# ENRICH_MODEL=gpt-6.1-sol
# ENRICH_REASONING_EFFORT=low
# DISCOVERY_MODEL=gpt-6-luna
# DISCOVERY_REASONING_EFFORT=low

# Gemini (optional: profile generator, or DISCOVERY_PROVIDER=gemini as a fallback)
GEMINI_API_KEY=
# DISCOVERY_PROVIDER=openai

# Deep dive: the outreach brief is off by default; set to on to bring it back
# DOSSIER_OUTREACH_BRIEF=off
# Second (social-posts) web search in dossiers: top = owners/founders/CEOs only
# (default), all = every contact, off = never. It is the costliest call.
# DOSSIER_SOCIAL_SEARCH=top

# Brave Search (Stage 2/3 web search)
BRAVE_SEARCH_API_KEY=

# Flask
SECRET_KEY=
FLASK_APP=app:create_app
FLASK_ENV=development

# development (default) or production. Railway sets production; leave as-is locally.
APP_ENV=development

# Optional shared password for the hosted version (blank = no password).
APP_PASSWORD=

# Optional. Unset = local SQLite in instance/. Railway sets this to its Postgres.
# DATABASE_URL=

# Active searcher profile (gc | accountant | attorney | photographer)
SEARCHER=gc

# Setting for searchers with multiple profiles (unless you have multiple profiles keep this null)
SHOW_SEARCHER_PICKER=